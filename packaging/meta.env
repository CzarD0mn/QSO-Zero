# Package description for M5Stack's AppBuilder packager (scripts/pack-deb.sh).
# Sourced by bash; VERSION comes from CI (git tag or snapshot) when set.
PKG_NAME=qso-zero
PKG_VERSION="${VERSION:-0.1.1}"
PKG_REVISION=1
PKG_ARCH="${PKG_ARCH:-$(dpkg --print-architecture 2>/dev/null || echo arm64)}"
PKG_DESC="FT8, JS8 and WSPR terminal for QRP radios on the Cardputer Zero"
PKG_DEPENDS="libc6 (>= 2.34), libhamlib-utils"
PKG_MAINTAINER="CzarD0mn <CzarD0mn@users.noreply.github.com>"
PKG_HOMEPAGE="https://github.com/CzarD0mn/QSO-Zero"
APP_NAME="QSO-Zero"
APP_EXEC=/usr/share/APPLaunch/bin/qso-zero
APP_TERMINAL=false
APP_ICON=share/images/qso-zero.png
APP_SYSPLAUSE=true
